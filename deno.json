{
  "name": "@cfs/core",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Shared Zod 4 schemas and pure utility helpers for CFS: Firestore/Typesense collection schemas, propagation rules, domain events, and date/order/invoice/product helpers.",
  "exports": {
    "./schemas": "./src/schemas/mod.ts",
    "./schemas/propagation": "./src/schemas/propagation/mod.ts",
    "./schemas/common": "./src/schemas/common.ts",
    "./schemas/booking": "./src/schemas/booking.ts",
    "./schemas/cache-geocodes": "./src/schemas/cache-geocodes.ts",
    "./schemas/card": "./src/schemas/card.ts",
    "./schemas/chart-of-accounts": "./src/schemas/chart-of-accounts.ts",
    "./schemas/contact": "./src/schemas/contact.ts",
    "./schemas/destination": "./src/schemas/destination.ts",
    "./schemas/email-verification": "./src/schemas/email-verification.ts",
    "./schemas/holiday-dates": "./src/schemas/holiday-dates.ts",
    "./schemas/holiday-definition": "./src/schemas/holiday-definition.ts",
    "./schemas/holiday-snapshot": "./src/schemas/holiday-snapshot.ts",
    "./schemas/inventory-ledger": "./src/schemas/inventory-ledger.ts",
    "./schemas/invite": "./src/schemas/invite.ts",
    "./schemas/invoice": "./src/schemas/invoice.ts",
    "./schemas/list": "./src/schemas/list.ts",
    "./schemas/location": "./src/schemas/location.ts",
    "./schemas/location-type": "./src/schemas/location-type.ts",
    "./schemas/order": "./src/schemas/order.ts",
    "./schemas/fulfillment": "./src/schemas/fulfillment.ts",
    "./schemas/organization": "./src/schemas/organization.ts",
    "./schemas/out-of-service": "./src/schemas/out-of-service.ts",
    "./schemas/password-reset": "./src/schemas/password-reset.ts",
    "./schemas/product": "./src/schemas/product.ts",
    "./schemas/recurrence": "./src/schemas/recurrence.ts",
    "./schemas/credit-note": "./src/schemas/credit-note.ts",
    "./schemas/session": "./src/schemas/session.ts",
    "./schemas/settlement": "./src/schemas/settlement.ts",
    "./schemas/stock": "./src/schemas/stock.ts",
    "./schemas/store": "./src/schemas/store.ts",
    "./schemas/tag": "./src/schemas/tag.ts",
    "./schemas/tracking-category": "./src/schemas/tracking-category.ts",
    "./schemas/transaction": "./src/schemas/transaction.ts",
    "./schemas/user": "./src/schemas/user.ts",
    "./schemas/webshop-product": "./src/schemas/webshop-product.ts",
    "./schemas/typesense": "./src/schemas/typesense/mod.ts",
    "./schemas/typesense/cards": "./src/schemas/typesense/cards.ts",
    "./schemas/quote": "./src/schemas/quote.ts",
    "./schemas/template": "./src/schemas/template.ts",
    "./schemas/template-context": "./src/schemas/template-context.ts",
    "./schemas/webhook-event": "./src/schemas/webhook-event.ts",
    "./schemas/log": "./src/schemas/log/mod.ts",
    "./schemas/pii": "./src/schemas/pii/mod.ts",
    "./schemas/pii/hash-node": "./src/schemas/pii/hash-node.ts",
    "./schemas/uploadcare": "./src/schemas/uploadcare/mod.ts",
    "./schemas/uploadcare-sweep": "./src/schemas/uploadcare-sweep.ts",
    "./schemas/uploadcare-worklist": "./src/schemas/uploadcare-worklist.ts",
    "./schemas/role": "./src/schemas/role.ts",
    "./schemas/permissions": "./src/schemas/permissions.ts",
    "./schemas/thread": "./src/schemas/thread.ts",
    "./schemas/comment": "./src/schemas/comment.ts",
    "./utils/bookings": "./src/utils/bookings.ts",
    "./utils/cards": "./src/utils/cards.ts",
    "./utils/contact-name": "./src/utils/contact-name.ts",
    "./utils/dates": "./src/utils/dates.ts",
    "./utils/icons": "./src/utils/icons.ts",
    "./utils/invoices": "./src/utils/invoices.ts",
    "./utils/locations": "./src/utils/locations.ts",
    "./utils/allocation": "./src/utils/allocation.ts",
    "./utils/stock": "./src/utils/stock.ts",
    "./utils/money": "./src/utils/money.ts",
    "./utils/movements": "./src/utils/movements.ts",
    "./utils/order-lines": "./src/utils/order-lines.ts",
    "./utils/orders": "./src/utils/orders.ts",
    "./utils/organizations": "./src/utils/organizations.ts",
    "./utils/products": "./src/utils/products.ts",
    "./utils/taxes": "./src/utils/taxes.ts",
    "./utils/templates": "./src/utils/templates.ts",
    "./utils/citations": "./src/utils/citations.ts"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-run --allow-write tests/",
    "lint": "deno lint",
    "audit:citations": "deno run --allow-read --allow-env scripts/audit-plan-citations.ts --strict",
    "check": "deno check src/ scripts/ tests/",
    "setup": "deno install && git config core.hooksPath .githooks && deno task fetch-llms-docs",
    "fetch-llms-docs": "deno run --allow-net=zod.dev,docs.deno.com --allow-read --allow-write scripts/fetch-llms-docs.ts",
    "generate-schema-template-fields": "deno run --allow-read --allow-write scripts/generate-schema-template-fields.ts",
    "generate-template-helpers": "deno run --allow-run --allow-read --allow-write scripts/generate-template-helpers.ts",
    "docs": "deno run --allow-run --allow-read --allow-write scripts/generate-api-docs.ts",
    "docs:check": "deno task docs && git diff --exit-code -- API.md API.json",
    "generate-lucide-icons": "deno run --allow-net=registry.npmjs.org --allow-read --allow-write scripts/generate-lucide-icons.ts"
  },
  "imports": {
    "zod": "npm:zod@^4.3.6",
    "date-fns": "npm:date-fns@^4.1.0",
    "@date-fns/tz": "npm:@date-fns/tz@^1.4.1",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "currency.js": "npm:currency.js@^2.0.4",
    "@conventional-commits/parser": "npm:@conventional-commits/parser@^0.4.1",
    "@std/tar": "jsr:@std/tar@^0.1.10"
  },
  "compilerOptions": {
    "strict": true
  },
  "publish": {
    "include": [
      "src/",
      "deno.json",
      "LICENSE",
      "README.md",
      "API.md",
      "API.json"
    ]
  }
}
