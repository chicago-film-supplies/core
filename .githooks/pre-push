#!/bin/sh
set -e

echo "pre-push: test"
deno task test

# ⚠️ pre-PUSH, not pre-commit. core#54 is removing the full suite from
# pre-commit; a new check there would inherit the double-run it deletes.
echo "pre-push: citations"
deno task audit:citations

# 🔴 The SAME audit at CI'S scope — core alone, siblings absent (core#106). The run
# above sees the whole workspace, so a bare `scripts/...` citation naming an
# api-cloudrun file resolves here and is BROKEN in CI. `publish.yaml` gates `release`
# on `needs: ci`, so that divergence SKIPS THE JSR PUBLISH while presenting as a
# failed docs commit. Five betas lost across two incidents (2026-09-10, 2026-09-17)
# before anything ran this.
echo "pre-push: citations (CI scope)"
deno task audit:citations:ci

# 🔴 The OTHER direction. The audit above checks the citations THIS repo owns,
# pointing outward; nothing checked citations pointing IN. So a rename here leaves
# this gate green while sibling repos that cite the old path go red — and the repo
# whose gate breaks is never the repo whose commit broke it.
#
# Measured 2026-09-05: manager relocating `src/**/__tests__/` to `tests/` left 2
# broken citations in THIS repo and 11 in api-cloudrun, both gates red, found
# hours apart by two sessions arriving at a blocked commit.
#
# ⚠️ Exits 0 with a SKIPPED notice when fewer than two siblings are checked out —
# a lone checkout is legitimate and must not fail, but it never reports "0 broken"
# either. CI can never run this: it checks out one repo.
echo "pre-push: inbound citations"
deno task audit:citations:inbound

echo "pre-push: publish dry-run"
deno publish --dry-run --allow-dirty
