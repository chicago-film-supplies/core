#!/bin/sh
# Fail closed. Without `set -e` this hook ran lint and the whole suite, printed
# every failure, and committed anyway — the hook's exit status was just the last
# command's (`git add`), so a red suite was indistinguishable from a green one.
set -e

echo "Running lint..."
deno task lint

# ⚠️ `deno task test` type-checks `src/` and `tests/` transitively — but nothing
# imports `scripts/`, so the generators were unchecked and had accumulated two
# TS7053s. First, because 1.7s of type error beats 15s of suite (core#64).
echo "Type-checking..."
deno task check

echo "Running tests..."
deno task test

echo "Regenerating API docs..."
deno task docs
git add API.md API.json
