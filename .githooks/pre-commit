#!/bin/sh
# Fail closed. Without `set -e` this hook ran lint and the whole suite, printed
# every failure, and committed anyway — the hook's exit status was just the last
# command's (`git add`), so a red suite was indistinguishable from a green one.
set -e

echo "Running lint..."
deno task lint

# ⚠️ `deno task test` type-checks `src/` and `tests/` transitively — but nothing
# imports `scripts/`, so the generators were unchecked and had accumulated two
# TS7053s. First, because 1.7s of type error beats 15s of suite (core#64).
echo "Type-checking..."
deno task check

# The two `.generated.ts` files under `src/schemas/`. Their staleness check used
# to live in the suite, where it SPAWNED each generator — and a spawned child
# carries its own permissions, so a green `deno task test` rewrote both tracked
# files. `deno task test` now runs read-only; this is where the byte-compare
# went. It is a diff against generator stdout, so it never writes.
echo "Checking generated files..."
deno task check:generated

# JSR publishes a `.d.ts` it generates SYNTACTICALLY, so a type needing inference
# is published wrong rather than rejected — invisible to lint, check, the suite
# and `deno publish --dry-run`, all of which read the source. Two have shipped.
echo "Checking declarations..."
deno task check:declarations

# ⚠️ The full suite is NOT here — core#54 item 5. It ran in this hook AND in
# `.githooks/pre-push` AND twice in CI, so a 5-commit-1-push session executed
# the identical hermetic suite 8 times; it is 2 now. `api-cloudrun` already made
# this trade the same way (`api-cloudrun/.claude/skills/cfs-testing/SKILL.md`: "stack your
# commits and push once, letting the hook be the single full run"), and the
# `--no-verify` path is covered because `.github/workflows/publish.yaml` fires
# on every push to `main`/`beta` and gates `release` on the checks.
#
# What stays here is the set that is cheap and answers a question the suite
# cannot: measured 2026-08-24 on a warm cache, lint 0.2s + check 0.1s +
# check:generated 1.0s + check:declarations 2.3s + docs 5.4s (~8.5s since
# core#98 regenerates from an extracted tree), against 12.3s for
# the suite alone. Run `deno task test` yourself while iterating; pre-push runs
# it for real.

# 🔴 Regenerate from the COMMIT'S OWN TREE, never the working tree (core#98).
# `deno doc` over the working tree swept a peer's uncommitted `src/` signature
# into an unrelated commit — and, the silent direction, a commit from a clean
# index reverted API.md under a peer's still-uncommitted change. `git write-tree`
# reads `GIT_INDEX_FILE`, which for a pathspec commit is git's temporary index:
# exactly what this commit will contain. Extracting it with `git archive` needs
# no worktree registration and nothing to clean up but a directory.
#
# The result is copied back and staged ONLY when it differs from the index, so
# a commit that changes no API surface leaves a peer's working-tree API.md alone.
# `deno task docs:check` in `.github/workflows/checks.yaml` is the backstop for
# a `--no-verify` commit. `.githooks/post-commit` is still needed: the `git add`
# below lands in the temporary index on a pathspec commit, never `.git/index`.
echo "Regenerating API docs from the commit's tree..."
_docs_tree=$(git write-tree)
_docs_dir=$(mktemp -d "${TMPDIR:-/tmp}/cfs-docs-core-XXXXXX")
trap 'rm -rf "$_docs_dir"' EXIT
trap 'exit 1' INT TERM
git archive -o "$_docs_dir/tree.tar" "$_docs_tree"
mkdir "$_docs_dir/tree"
tar -xf "$_docs_dir/tree.tar" -C "$_docs_dir/tree"
rm -f "$_docs_dir/tree.tar"
(cd "$_docs_dir/tree" && deno run --allow-run --allow-read --allow-write scripts/generate-api-docs.ts)
for _f in API.md API.json; do
  if [ "$(git hash-object "$_docs_dir/tree/$_f")" != "$(git rev-parse -q --verify ":$_f" || true)" ]; then
    cp "$_docs_dir/tree/$_f" "$_f"
    git add "$_f"
  fi
done
